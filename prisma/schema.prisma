generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// User & Role
// ============================================================

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        String   @default("HOMEOWNER") // HOMEOWNER | COMPANY | ADMIN
  name        String?
  phone       String?
  email       String?
  avatar      String?
  isDisabled  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownedProjects    Project[]        @relation("ProjectOwner")
  memberProjects   Project[]        @relation("ProjectMembers")
  comments         Comment[]
  nodeComments     NodeComment[]
  createdNodes     Node[]           @relation("NodeCreator")
  materials        Material[]
  activityLogs     ActivityLog[]
  nodeEntries      NodeEntry[]
  progressRecords  ProgressRecord[]
}

// ============================================================
// Project
// ============================================================

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  ownerId     String
  status      String    @default("PLANNING") // PLANNING | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  address     String?
  area        Float?
  community   String?
  contract    String?
  qrCode      String?
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner        User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  members      User[]        @relation("ProjectMembers")
  phases       Phase[]
  nodes        Node[]
  materials    Material[]
  comments     Comment[]
  logs         ActivityLog[]

  @@index([ownerId])
  @@index([status])
}

// ============================================================
// Phase (装修阶段)
// ============================================================

model Phase {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  phaseKey    String    @default("PLANNING") // PLANNING|DEMOLITION|WATERPROOF|HYDROPOWER|TILING|CARPENTRY|PAINTING|FURNITURE|COMPLETION
  description String?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED
  order       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes       Node[]

  @@index([projectId])
  @@index([order])
}

// ============================================================
// Node (装修节点/工序)
// ============================================================

model Node {
  id           String    @id @default(cuid())
  phaseId      String
  projectId    String
  title        String
  description  String?
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | BLOCKED
  urgency      String    @default("NORMAL")  // NORMAL | TODO | URGENT | EMERGENCY
  assignee     String?
  plannedDate  DateTime?
  actualDate   DateTime?
  photos       String    @default("[]")
  problems     String    @default("[]")
  order        Int       @default(0)
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  phase           Phase            @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator         User             @relation("NodeCreator", fields: [createdBy], references: [id])
  nodeComments    NodeComment[]
  materials       Material[]
  activityLogs    ActivityLog[]
  entries         NodeEntry[]
  progressRecords ProgressRecord[]

  @@index([phaseId])
  @@index([projectId])
  @@index([status])
  @@index([order])
}

// ============================================================
// NodeEntry (节点日志记录)
// ============================================================

model NodeEntry {
  id          String   @id @default(cuid())
  nodeId      String
  type        String   @default("PROGRESS") // PHOTO | ISSUE | MATERIAL | DIALOGUE | PROGRESS | INSPECTION
  title       String
  content     String?
  urgency     String   @default("NORMAL")
  mediaUrls   String   @default("[]")
  isCompleted Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  node        Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  creator     User     @relation(fields: [createdBy], references: [id])

  @@index([nodeId])
  @@index([type])
}

// ============================================================
// ProgressRecord (节点进度百分比记录)
// ============================================================

model ProgressRecord {
  id          String   @id @default(cuid())
  nodeId      String
  percentage  Int      @default(0)
  note        String?
  recordedBy  String
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  node        Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  recorder    User     @relation(fields: [recordedBy], references: [id])

  @@index([nodeId])
  @@index([recordedAt])
}

// ============================================================
// NodeComment (节点专属评论)
// ============================================================

model NodeComment {
  id        String   @id @default(cuid())
  nodeId    String
  projectId String?
  content   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([nodeId])
}

// ============================================================
// Comment (通用评论)
// ============================================================

model Comment {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  content    String
  userId     String
  projectId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([projectId])
}

// ============================================================
// Material (材料记录)
// ============================================================

model Material {
  id          String   @id @default(cuid())
  nodeId      String?
  projectId   String
  name        String
  description String?
  brand       String?
  category    String   @default("main")
  status      String   @default("NOT_PURCHASED")
  pickupCode  String?
  quantity    Int      @default(1)
  unit        String?
  price       Float?
  addedBy     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  node        Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adder       User     @relation(fields: [addedBy], references: [id])

  @@index([projectId])
  @@index([nodeId])
}

// ============================================================
// ActivityLog
// ============================================================

model ActivityLog {
  id          String   @id @default(cuid())
  projectId   String
  nodeId      String?
  action      String
  entityType  String
  entityId    String
  description String?
  changes     String   @default("{}")
  userId      String
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node        Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([nodeId])
  @@index([createdAt])
}
